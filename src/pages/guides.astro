---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Surface from "../components/Surface.astro";

const articles = [
  await import("./support/stay_organized.mdx"),
  await import("./support/links.mdx"),
  await import("./support/images.mdx"),
  await import("./support/notes.mdx"),
  await import("./support/share_ios.mdx"),
  await import("./support/extensions.mdx"),
  await import("./support/icloud.mdx"),
  await import("./support/ai.mdx"),
];
---

<Layout title="Guides · Bleep">
  <SiteHeader fixed={false} />
  <main
    class="max-w-160 mx-auto px-[var(--safe-area-padding)] pb-16 pt-8 md:pt-16"
  >
    <h1 class="font-display font-normal text-2xl md:text-3xl pb-6">Guides</h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {
        articles.map((article) => (
          <Surface
            as="a"
            href={article.url}
            class="group flex flex-col gap-3 p-4 rounded-2xl transition-all duration-200 no-underline shadow-xs rounded-xl"
          >
            <span class="shrink-0 flex items-center justify-center w-10 h-10 rounded-lg bg-black/4 text-lg dark:bg-white/8">
              {article.frontmatter.icon}
            </span>
            <div class="min-w-0">
              <span class="block font-medium text-black dark:text-white transition-colors duration-200">
                {article.frontmatter.support_title || article.frontmatter.title}
              </span>
              {article.frontmatter.subtitle && (
                <span class="block text-sm text-zinc-500 dark:text-zinc-400 leading-snug mt-0.5">
                  {article.frontmatter.subtitle}
                </span>
              )}
            </div>
          </Surface>
        ))
      }
    </div>
  </main>
  <SiteFooter />
</Layout>
