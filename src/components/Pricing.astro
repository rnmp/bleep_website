---
import Surface from "../components/Surface.astro";
---

<div class="relative sm:mx-auto pb-20 flex flex-col items-center gap-10">
  <div class="absolute -top-31" id="pricing"></div>
  <div class="text-center flex flex-col items-center">
    <span class="font-display-caps text-[var(--color-accent)] text-sm">
      Pricing
    </span>
    <h1
      class="font-display font-normal text-3xl sm:text-[2.5rem] leading-[1.2] mt-8 mb-8"
    >
      Enjoy Bleep 100% free,<br />super charge with Pro
    </h1>

    <fieldset
      id="plan_timeframe_selector"
      class="text-xs font-semibold p-1 rounded-full bg-black/4 dark:bg-white/4 flex"
    >
      <label
        for="plan_timeframe_monthly"
        class="has-checked:bg-white dark:has-checked:bg-white/30 has-checked:text-accent dark:has-checked:text-white has-checked:ring has-checked:ring-black/8 dark:has-checked:ring-white/50 px-3 py-1 inline-block rounded-full cursor-pointer"
      >
        <input
          class="hidden"
          type="radio"
          id="plan_timeframe_monthly"
          name="plan_timeframe"
          value="monthly"
        />
        Monthly
      </label>
      <label
        for="plan_timeframe_annually"
        class="has-checked:bg-white dark:has-checked:bg-white/30 has-checked:text-accent dark:has-checked:text-white has-checked:ring has-checked:ring-black/8 dark:has-checked:ring-white/50 px-3 py-1 inline-block rounded-full cursor-pointer"
      >
        <input
          class="hidden"
          type="radio"
          checked
          id="plan_timeframe_annually"
          name="plan_timeframe"
          value="annually"
        />
        Yearly
      </label>
      <label
        for="plan_timeframe_lifetime"
        class="has-checked:bg-white dark:has-checked:bg-white/30 has-checked:text-accent dark:has-checked:text-white has-checked:ring has-checked:ring-black/8 dark:has-checked:ring-white/50 px-3 py-1 inline-block rounded-full cursor-pointer"
      >
        <input
          class="hidden"
          type="radio"
          name="plan_timeframe"
          id="plan_timeframe_lifetime"
          value="lifetime"
        />
        Lifetime
      </label>
    </fieldset>
  </div>

  <div class="flex flex-row gap-4 w-full p-6 overflow-auto">
    <Surface
      class="w-67 sm:w-72 p-5 pb-6 sm:p-7 shrink-0 sm:pb-8 flex flex-col text-start gap-5"
    >
      <h3 class="mb-1 font-bold">Bleep</h3>
      <h3 class="font-display text-3xl">Free</h3>
      <ul class="text-sm flex flex-col gap-1">
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Unlimited items & rooms
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Browser extension
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          100% private, no sign ups
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Access items offline
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Sync devices via iCloud
        </li>
      </ul>
      <a
        class="inline-block leading-4 text-center bg-white text-black font-semibold ring ring-black/8 text-[0.95rem] rounded-full py-2.5 px-6 no-underline"
        href="https://apps.apple.com/app/bleep-think-visually/id1638417383"
      >
        Try Bleep for Free
      </a>
    </Surface>
    <Surface
      class="w-67 sm:w-72 p-5 pb-6 sm:p-7 shrink-0 sm:pb-8 flex flex-col text-start gap-5"
    >
      <h2 class="mb-1 font-bold">Bleep Pro</h2>
      <h3 class="flex items-end gap-2">
        <span id="plan_price_amount" class="font-display text-3xl">
          $29.99
        </span>
        <span
          id="plan_price_description"
          class="text-sm text-gray-600 dark:text-gray-400">billed yearly</span
        >
      </h3>
      <ul class="text-sm flex flex-col gap-1">
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Add items to multiple rooms
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Pinned items
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Bulk-edit items
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          Customize bookmarks
        </li>
        <li class="flex items-center gap-2">
          <svg
            class="w-3.5 h-3.5 shrink-0 text-[var(--color-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><polyline points="20 6 9 17 4 12"></polyline></svg
          >
          & more...
        </li>
      </ul>
      <a
        class="inline-block leading-4 text-center bg-white text-black font-semibold ring ring-black/8 text-[0.95rem] rounded-full py-2.5 px-6 no-underline"
        href="https://apps.apple.com/app/bleep-think-visually/id1638417383"
      >
        Try Bleep for Free
      </a>
    </Surface>
  </div>
</div>

<script>
  const timeframeSelector = document.getElementById("plan_timeframe_selector");
  const priceAmount = document.getElementById("plan_price_amount");
  const priceDescription = document.getElementById("plan_price_description");

  timeframeSelector?.addEventListener("change", (event) => {
    if (!(event.target instanceof HTMLInputElement)) return;

    const [amount, description] = (() => {
      switch (event.target.value) {
        case "monthly":
          return ["$3.99", "billed monthly"];
        case "lifetime":
          return ["$99.99", "billed once"];
        default:
          return ["$29.99", "billed yearly"];
      }
    })();

    if (priceAmount) priceAmount.textContent = amount;
    if (priceDescription) priceDescription.textContent = description;
  });
</script>
